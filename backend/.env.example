# Koneksi PostgreSQL (lihat docker-compose.yml di root repo)
DATABASE_URL="postgresql://money:money_secret@localhost:5432/money_management?schema=public"

PORT=4000
# Origin frontend yang diizinkan (CORS). Pisahkan dengan koma bila lebih dari satu.
CORS_ORIGIN=http://localhost:3000
# Masa berlaku sesi login (hari)
SESSION_TTL_DAYS=7
# Set true di production (cookie hanya dikirim via HTTPS)
COOKIE_SECURE=false
# Zona waktu untuk agregasi laporan harian/bulanan
APP_TIMEZONE=Asia/Jakarta

# Smart Import — folder penyimpanan privat untuk file unggahan (tidak disajikan publik)
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10

# Opsional: ekstraksi struk & PDF e-statement memakai Claude (Anthropic API).
# Tanpa key ini, CSV/XLSX tetap diproses otomatis; struk diisi manual saat review.
ANTHROPIC_API_KEY=

# Opsional (gratis, offline): OCR lokal untuk foto struk memakai PaddleOCR (folder ocr-service/).
# Dipakai bila ANTHROPIC_API_KEY kosong. Kosongkan untuk mengisi struk secara manual.
OCR_SERVICE_URL=http://localhost:8866
OCR_TIMEOUT_MS=120000
